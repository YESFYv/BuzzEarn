<!DOCTYPE html><html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>BuzzEarn</title><style>*{box-sizing:border-box}body{margin:0;font-family:Arial;background:#f8f7ff}.card{background:white;margin:12px 16px;padding:16px;border-radius:16px;box-shadow:0 2px 10px rgba(0,0,0,.06)}.btn{border:0;padding:12px 18px;border-radius:12px;font-weight:bold;cursor:pointer}.btn-purple{background:#6C5CE7;color:white}.btn-green{background:#00b894;color:white;width:100%}.paywall{min-height:100vh;display:flex;align-items:center;justify-content:center;padding:16px;background:linear-gradient(135deg,#6C5CE7,#a29bfe)}.task{display:flex;justify-content:space-between;align-items:center;padding:14px;background:white;margin:8px 16px;border-radius:14px}.dash-head{background:#6C5CE7;color:white;padding:20px;border-radius:0 0 28px 28px}.nav{position:fixed;bottom:0;left:0;width:100%;background:white;display:flex;justify-content:space-around;padding:12px 0;border-top:1px solid #eee}</style></head><body>
<div id="payScreen" class="paywall"><div class="card" style="max-width:380px;width:100%"><h2>BuzzEarn</h2><small style="color:#6C5CE7;font-weight:bold">Earn Daily</small><hr><h3>🔒 Pay N500 to Activate</h3><p style="font-size:14px">Pay N500 registration to unlock dashboard. Earn N50-N100 per task. Withdraw min N2000.</p><input id="regName" placeholder="Full Name" style="width:100%;padding:12px;border-radius:10px;border:1px solid #ddd;margin-bottom:8px"><input id="regPhone" placeholder="Phone" style="width:100%;padding:12px;border-radius:10px;border:1px solid #ddd;margin-bottom:12px"><button class="btn btn-purple" style="width:100%;padding:14px" onclick="payNow()">Pay N500 & Activate →</button><div style="margin-top:10px;text-align:center"><small>Already paid? <b style="color:#6C5CE7;cursor:pointer" onclick="checkAlready()">Login</b></small></div></div></div>
<div id="mainApp" style="display:none;padding-bottom:80px"><div class="dash-head"><b>BuzzEarn</b><br><small>Welcome, <span id="uName">Boss</span> ___</small><div style="background:white;color:#333;padding:14px;border-radius:16px;margin-top:14px"><small>Available Balance</small><h1 id="bal" style="margin:6px 0">N0</h1><small>Min withdraw N2000</small></div></div>
<div id="view-dashboard"><div class="card">Tasks Done: <b id="doneCount">0</b><br>Earned: <b id="earnCount">N0</b></div></div>
<div id="view-tasks" style="display:none"><h3 style="padding:0 16px">Tasks N50/N100</h3><div id="tasksBox"></div></div>
<div id="view-profile" style="display:none"><h3 style="padding:0 16px">Profile & Withdrawal - Min N2000</h3><div class="card"><b>Withdrawal</b><br><small>Minimum na <b>N2000</b> as you want now</small><br><br><input id="acctNum" placeholder="Opay/Bank Number" style="width:100%;padding:12px;border-radius:10px;border:1px solid #ddd;margin-bottom:8px"><input id="acctName" placeholder="Account Name" style="width:100%;padding:12px;border-radius:10px;border:1px solid #ddd;margin-bottom:10px"><button class="btn btn-purple" style="width:100%" onclick="withdraw()">Request Withdrawal (Min N2000)</button></div></div>
<div class="nav"><span onclick="switchTab('dashboard')" id="nav-dash" style="color:#6C5CE7;font-weight:bold">Dashboard</span><span onclick="switchTab('tasks')" id="nav-tasks">Tasks</span><span onclick="switchTab('profile')" id="nav-prof">Profile</span></div></div>
<script>
let bal=Number(localStorage.getItem('buzz_bal')||0);let watched=JSON.parse(localStorage.getItem('buzz_watched')||'[]');let isPaid=localStorage.getItem('buzz_paid')==='yes';let uname=localStorage.getItem('buzz_name')||'Boss';if(isPaid)showMain();function checkAlready(){if(isPaid)showMain();else alert('Pay N500 first');}
function payNow(){let n=document.getElementById('regName').value;if(!n)return alert('Enter name');localStorage.setItem('buzz_paid','yes');localStorage.setItem('buzz_name',n);uname=n;showMain();}
function showMain(){document.getElementById('payScreen').style.display='none';document.getElementById('mainApp').style.display='block';document.getElementById('uName').innerText=uname;document.getElementById('bal').innerText='N'+bal;document.getElementById('doneCount').innerText=watched.length;document.getElementById('earnCount').innerText='N'+bal;renderTasks();}
let tasksList=[{t:'Follow IG Page',r:50},{t:'Like TikTok',r:100},{t:'Subscribe YouTube',r:50},{t:'Comment FB',r:50},{t:'Share WhatsApp Status',r:100},{t:'Watch 60s Video',r:50},{t:'Daily Bonus',r:100},{t:'Join Telegram',r:50},{t:'Retweet X',r:50},{t:'Like FB Page',r:100},{t:'View Ad 30s',r:50},{t:'Follow Twitter',r:50},{t:'Comment YouTube',r:100},{t:'Share FB Post',r:50},{t:'Watch TikTok',r:100},{t:'Rate App 5 Star',r:50},{t:'Invite Test',r:100},{t:'Complete Survey',r:50},{t:'Click Ads',r:100},{t:'Play Game Ad',r:50}];
function renderTasks(){let box=document.getElementById('tasksBox');box.innerHTML='';tasksList.forEach((v,i)=>{let done=watched.includes(i);box.innerHTML+='<div class="task"><div><b>'+v.t+'</b><br><small style="color:#6C5CE7">+N'+v.r+'</small><div id="timer-'+i+'" style="display:none;color:red;font-size:11px">45s...</div></div>'+(done?'<b style="color:green">✓</b>':'<div><button class="btn btn-purple" style="padding:8px 12px;font-size:12px" id="btn-'+i+'" onclick="doTask('+i+')">Do</button><button class="btn btn-green" style="display:none;padding:8px 12px;font-size:12px" id="claim-'+i+'" onclick="claim('+i+','+v.r+')">Claim</button></div>')+'</div>';});}
function switchTab(t){document.getElementById('view-dashboard').style.display=t==='dashboard'?'block':'none';document.getElementById('view-tasks').style.display=t==='tasks'?'block':'none';document.getElementById('view-profile').style.display=t==='profile'?'block':'none';}
function doTask(id){window.open('https://youtube.com','_blank');document.getElementById('timer-'+id).style.display='block';document.getElementById('btn-'+id).style.display='none';let left=45;let iv=setInterval(()=>{left--;document.getElementById('timer-'+id).innerText=left+'s verifying...';if(left<=0){clearInterval(iv);document.getElementById('timer-'+id).style.display='none';document.getElementById('claim-'+id).style.display='inline-block';}},1000);}
function claim(id,r){bal+=r;watched.push(id);localStorage.setItem('buzz_bal',bal);localStorage.setItem('buzz_watched',JSON.stringify(watched));document.getElementById('bal').innerText='N'+bal;document.getElementById('doneCount').innerText=watched.length;document.getElementById('earnCount').innerText='N'+bal;renderTasks();}
function withdraw(){if(bal<2000)return alert('Min withdraw na N2000. You get N'+bal);let num=document.getElementById('acctNum').value;if(!num)return alert('Enter account');alert('Withdrawal N'+bal+' requested! Owner profit N500 fee + keep am.');localStorage.setItem('buzz_bal',0);localStorage.setItem('buzz_watched','[]');location.reload();}
</script></body></html>
